TELEGRAM_BOT_TOKEN=
# Maximum number of active image jobs across all users (positive integer).
MAX_CONCURRENT_GENERATIONS=2
# Optional absolute path to a persistent SQLite database.
STATS_DB_PATH=
# Required when STATS_DB_PATH is set.
STATS_HMAC_KEY=
# Required: a separate SQLite file in an existing writable directory.
PREFS_DB_PATH=
# Required: a separate permanent secret for preferences.
PREFS_HMAC_KEY=
